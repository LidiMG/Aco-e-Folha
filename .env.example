# Copie este arquivo para ".env" (mesma pasta) e preencha com os seus valores.
# O arquivo ".env" nunca deve ir para o Git — já está protegido no .gitignore.
# Depois de criar/editar o .env, é só rodar "python app.py" normalmente —
# não precisa mais de nenhum "export" manual no terminal.

GOOGLE_SERVICE_ACCOUNT_FILE=/caminho/para/sua-chave.json
GOOGLE_SHEET_ID=id_da_planilha
# Pasta PRIVADA dos comprovantes de PIX (dados pessoais e bancários)
GOOGLE_DRIVE_FOLDER_ID=id_da_pasta_dos_comprovantes
# Pasta das fotos dos alvos (Arco/Machado) — pode ficar privada: a tela de
# Resultados busca as fotos pelo próprio app, sem login Google
GOOGLE_DRIVE_ALVOS_FOLDER_ID=id_da_pasta_das_fotos_dos_alvos
GOOGLE_OAUTH_CLIENT_ID=123...apps.googleusercontent.com
GOOGLE_DRIVE_TOKEN_FILE=drive_token.json
FLASK_SECRET_KEY=uma-string-longa-e-aleatoria-qualquer

# Acessos (v3)
# Código da equipe: pedido uma vez por celular em Competições e Aquisição.
# Use só números (4 a 6). Troque a cada evento. Vazio = nada é pedido.
CODIGO_EQUIPE=
# E-mail Google do organizador: registra desempates e corrige notas.
EMAIL_ORGANIZACAO=organizador@gmail.com
# E-mail Google da administração: tudo isso, mais a área de Administração.
EMAIL_ADMINISTRACAO=seuemail@gmail.com
# (Mais de um e-mail em qualquer uma das duas: separe por vírgula.)

# Opcional — se vazio, qualquer Conta Google consegue entrar (com o código)
ALLOWED_EMAILS=
